@page
@model PacheteAPP.Pages.PachetPages.IndexModel

@{
    ViewData["Title"] = "Pachete";
}

@using Microsoft.AspNetCore.Authorization;
@inject IAuthorizationService AuthorizationService;

<h1 class="h3 mb-4">Lista Pachete</h1>

<p>
    @if((await AuthorizationService.AuthorizeAsync(User, "CanCreate")).Succeeded)
    {
        <a asp-page="CreatePachet" class="btn btn-sm btn-outline-primary">Creeaza Pachet Nou</a>
    }
</p>

<form method="get" class="mb-4">
    <div class="row g-3">
        <div class="col-md-2">
            <input type="text" name="searchAwb" value="@Model.searchAwbCurent" class="form-control" placeholder="Cauta AWB..." />
        </div>
        <div class="col-md-2">
            <input type="text" name="searchExpeditor" value="@Model.searchExpeditorCurent" class="form-control" placeholder="Cauta Expeditor..." />
        </div>
        <div class="col-md-2">
            <input type="text" name="searchDestinatar" value="@Model.searchDestinatarCurent" class="form-control" placeholder="Cauta Destinatar..." />
        </div>

        <div class="col-md-2">
            <select name="filtru" class="form-select">
                <option value="">Toate tipurile</option>
                <option value="1" selected="@(Model.filtruCurent == 1 ? "selected" : null)">Plic</option>
                <option value="2" selected="@(Model.filtruCurent == 2 ? "selected" : null)">Cutie</option>
                <option value="3" selected="@(Model.filtruCurent == 3 ? "selected" : null)">Palet</option>
            </select>
        </div>
        <div class="col-md-2">
            <select name="status" class="form-select">
                <option value="">Orice Status</option>
                <option value="1">Inregistrat</option>
                <option value="2">In Tranzit</option>
                <option value="3">Livrat</option>
                <option value="4">Probleme</option>
                <option value="5">Retur</option>
            </select>
        </div>
        <div class="col-md-1">
            <button type="submit" class="btn btn-primary w-100">Aplica Filtre</button>
        </div>
        <div class="col-md-1">
            <a href="?" class="btn btn-outline-secondary w-100">Reset</a>
        </div>
    </div>
    <input type="hidden" name="sort" value="@Model.sortCurent" />
</form>

<table class="table table-striped table-hover align-middle">
    <thead>
        <tr>
            <th>
                <a href="?p=1&sort=@(Model.sortCurent == "awb_asc" ? "awb_des" : "awb_asc")&search=@Model.searchAwbCurent&filtru=@Model.filtruCurent" class="text-decoration-none text-dark">
                    AWB @(Model.sortCurent == "awb_asc" ? "↑" : Model.sortCurent == "awb_des" ? "↓" : "")
                </a>
            </th>
            <th>Tip Pachet</th>
            <th>Descriere</th>
            <th>
                <a href="?p=1&sort=@(Model.sortCurent == "email_expeditor_asc" ? "email_expeditor_des" : "email_expeditor_asc")&search=@Model.searchExpeditorCurent&filtru=@Model.filtruCurent" class="text-decoration-none text-dark">
                    Expeditor @(Model.sortCurent == "email_expeditor_asc" ? "↑" : Model.sortCurent == "email_expeditor_des" ? "↓" : "")
                </a>
            </th>
            <th>
                <a href="?p=1&sort=@(Model.sortCurent == "email_destinatar_asc" ? "email_destinatar_des" : "email_destinatar_asc")&search=@Model.searchDestinatarCurent&filtru=@Model.filtruCurent" class="text-decoration-none text-dark">
                    Destinatar @(Model.sortCurent == "email_destinatar_asc" ? "↑" : Model.sortCurent == "email_destinatar_des" ? "↓" : "")
                </a>
            </th>
            <th>Data Adaugare</th>
            <th>
                <a href="?p=1&sort=@(Model.sortCurent == "nr_deteriorari_asc" ? "nr_deteriorari_des" : "nr_deteriorari_asc")&search=@Model.searchDestinatarCurent&filtru=@Model.filtruCurent" class="text-decoration-none text-dark">
                    Numar Deteriorari @(Model.sortCurent == "nr_deteriorari_asc" ? "↑" : Model.sortCurent == "nr_deteriorari_des" ? "↓" : "")
                </a>
            </th>
            <th>
                <a href="?p=1&sort=@(Model.sortCurent == "nr_infolipsa_asc" ? "nr_infolipsa_des" : "nr_infolipsa_asc")&search=@Model.searchDestinatarCurent&filtru=@Model.filtruCurent" class="text-decoration-none text-dark">
                    Numar InfoLipsa @(Model.sortCurent == "nr_infolipsa_asc" ? "↑" : Model.sortCurent == "nr_infolipsa_des" ? "↓" : "")
                </a>
            </th>
            <th>Status</th>
            <th>Actiuni</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Pachet)
        {
            <tr>
                <td><strong>@item.awb</strong></td>
                <td>@item.tip_pachet</td>
                <td>@item.descriere_pachet</td>
                <td>@item.nume_complet_expeditor</td>
                <td>@item.nume_complet_destinatar</td>
                <td>@item.data_inregistrare</td>
                <td>@item.numar_deteriorari</td>
                <td>@item.numar_infolipsa</td>
                <td>
                    <span class="badge bg-secondary">@item.status_pachet</span>
                </td>
                <td>
                    @if((await AuthorizationService.AuthorizeAsync(User, "CanEdit")).Succeeded)
                    {
                        <a asp-page="./EditPachet" asp-route-id_pachet="@item.id_pachet" class="btn btn-sm btn-secondary">Edit</a>
                    }
                    @if((await AuthorizationService.AuthorizeAsync(User, "CanView")).Succeeded)
                    {
                        <a asp-page="./DetailsPachet" asp-route-id_pachet="@item.id_pachet" class="btn btn-sm btn-primary">Details</a>
                    }
                    @if((await AuthorizationService.AuthorizeAsync(User, "CanDelete")).Succeeded)
                    {
                        <a asp-page="./DeletePachet" asp-route-id_pachet="@item.id_pachet" class="btn btn-sm btn-danger">Delete</a>
                    }
                    @if((await AuthorizationService.AuthorizeAsync(User, "CanView")).Succeeded)
                    {
                        <a asp-page="./InregistrariPachet" asp-route-awbPachet="@item.awb" class="btn btn-sm btn-warning">Vezi Probleme</a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

<nav aria-label="Page navigation" class="mt-4">
    <ul class="pagination justify-content-center">
        <li class="page-item @(Model.paginaCurenta <= 1 ? "disabled" : "")">
            <a class="page-link" href="?p=1&sort=@Model.sortCurent&searchAwb=@Model.searchAwbCurent&searchExpeditor=@Model.searchExpeditorCurent&searchDestinatar=@Model.searchDestinatarCurent&filtru=@Model.filtruCurent"> &laquo;&laquo; </a>
        </li>

        <li class="page-item @(Model.paginaCurenta <= 1 ? "disabled" : "")">
            <a class="page-link" href="?p=@(Model.paginaCurenta - 1)&sort=@Model.sortCurent&searchAwb=@Model.searchAwbCurent&searchExpeditor=@Model.searchExpeditorCurent&searchDestinatar=@Model.searchDestinatarCurent    &filtru=@Model.filtruCurent"> &lt; </a>
        </li>

        @{
            int maxButoane = 5;
            int startPage = Math.Max(1, Model.paginaCurenta - 2);
            int endPage = Math.Min(Model.paginiTotale, Model.paginaCurenta + 2);

            if (endPage - startPage < maxButoane - 1 && Model.paginiTotale >= maxButoane)
            {
                if (startPage == 1)
                    endPage = maxButoane;
                else if (endPage == Model.paginiTotale)
                    startPage = Model.paginiTotale - maxButoane + 1;
            }
        }

        @if (startPage > 1)
        {
            <li class="page-item disabled"><span class="page-link">...</span></li>
        }

        @for (int i = startPage; i <= endPage; i++)
        {
            <li class="page-item @(i == Model.paginaCurenta ? "active" : "")">
                <a class="page-link" href="?p=@i&sort=@Model.sortCurent&searchAwb=@Model.searchAwbCurent&searchExpeditor=@Model.searchExpeditorCurent&searchDestinatar=@Model.searchDestinatarCurent&filtru=@Model.filtruCurent">@i</a>
            </li>
        }

        @if (endPage < Model.paginiTotale)
        {
            <li class="page-item disabled"><span class="page-link">...</span></li>
        }

        <li class="page-item @(Model.paginaCurenta >= Model.paginiTotale ? "disabled" : "")">
            <a class="page-link" href="?p=@(Model.paginaCurenta + 1)&sort=@Model.sortCurent&searchAwb=@Model.searchAwbCurent&searchExpeditor=@Model.searchExpeditorCurent&searchDestinatar=@Model.searchDestinatarCurent&filtru=@Model.filtruCurent"> &gt; </a>
        </li>

        <li class="page-item @(Model.paginaCurenta >= Model.paginiTotale ? "disabled" : "")">
            <a class="page-link" href="?p=@Model.paginiTotale&sort=@Model.sortCurent&searchAwb=@Model.searchAwbCurent&searchExpeditor=@Model.searchExpeditorCurent&searchDestinatar=@Model.searchDestinatarCurent&filtru=@Model.filtruCurent"> &raquo;&raquo; </a>
        </li>
    </ul>
</nav>