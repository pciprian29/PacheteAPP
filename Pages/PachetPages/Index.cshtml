@page
@model PacheteAPP.Pages.PachetPages.IndexModel

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-page="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Pachet[0].awb)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Pachet[0].descriere)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Pachet[0].tip_pachet)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Pachet[0].nume_expeditor)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Pachet[0].adresa_expeditor)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Pachet[0].nume_destinatar)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Pachet[0].adresa_destinatar)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Pachet[0].data_inregistrare)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Pachet[0].greutate_teoretica)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Pachet[0].greutate_efectiva)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Pachet[0].status_pachet)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Pachet[0].id_user)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.Pachet) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.awb)
            </td>
            <td>
                @Html.DisplayFor(model => item.descriere)
            </td>
            <td>
                @Html.DisplayFor(model => item.tip_pachet)
            </td>
            <td>
                @Html.DisplayFor(model => item.nume_expeditor)
            </td>
            <td>
                @Html.DisplayFor(model => item.adresa_expeditor)
            </td>
            <td>
                @Html.DisplayFor(model => item.nume_destinatar)
            </td>
            <td>
                @Html.DisplayFor(model => item.adresa_destinatar)
            </td>
            <td>
                @Html.DisplayFor(model => item.data_inregistrare)
            </td>
            <td>
                @Html.DisplayFor(model => item.greutate_teoretica)
            </td>
            <td>
                @Html.DisplayFor(model => item.greutate_efectiva)
            </td>
            <td>
                @Html.DisplayFor(model => item.status_pachet)
            </td>
            <td>
                @Html.DisplayFor(model => item.id_user)
            </td>
            <td>
                <a asp-page="./Edit" asp-route-id="@item.id_pachet">Edit</a> |
                <a asp-page="./Details" asp-route-id="@item.id_pachet">Details</a> |
                <a asp-page="./Delete" asp-route-id="@item.id_pachet">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
