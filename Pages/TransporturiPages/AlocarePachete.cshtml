@page
@model PacheteAPP.Pages.TransporturiPages.AlocarePacheteModel
@{
    ViewData["Title"] = "Alocare Pachete";
}

<link href="https://cdn.jsdelivr.net/npm/tom-select@2.2.2/dist/css/tom-select.bootstrap5.min.css" rel="stylesheet">

<div class="container-fluid mt-4">
    <div class="card shadow-sm mb-4">
        <div class="card-body d-flex justify-content-between align-items-center bg-light">
            <div>
                <h4 class="mb-0">Transport #@Model.TransportCurent.id_transport : @Model.TransportCurent.numar_auto</h4>
                <small class="text-muted">
                    Ruta: @Model.TransportCurent.Ruta?.cod_ruta | ID Sofer: @Model.TransportCurent.id_user
                </small>
            </div>
            <a asp-page="./IndexTransporturi" class="btn btn-secondary">Inapoi la Lista</a>
        </div>
    </div>

    @if (TempData["Succes"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Succes"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Eroare"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Eroare"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row">
        <div class="col-md-4">
            <div class="card shadow-sm border-primary">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Adauga AWB</h5>
                </div>
                <div class="card-body">
                    <form method="post">
                        <div class="form-group mb-3">
                            <label asp-for="AwbAdaugat" class="form-label">Introdu AWB-ul:</label>
                            <select asp-for="AwbAdaugat" id="select-awb" class="form-select"></select>
                        </div>
                        <button type="submit" class="btn btn-success w-100 btn-lg">Adauga Pachet</button>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Pachete in Masina</h5>
                    <span class="badge bg-light text-dark">@Model.PacheteDejaAlocate.Count</span>
                </div>
                <div class="card-body p-0">
                    <table class="table table-striped table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>AWB</th>
                                <th>Adresa Livrare</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.PacheteDejaAlocate.Any())
                            {
                                foreach (var pt in Model.PacheteDejaAlocate)
                                {
                                    <tr>
                                        <td><strong>@pt.Pachet.awb</strong></td>
                                        <td>@pt.Pachet.adresa_destinatar</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="2" class="text-center text-muted py-3">Niciun pachet adaugat momentan.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/tom-select@2.2.2/dist/js/tom-select.complete.min.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function() {
            new TomSelect('#select-awb', {
                valueField: 'awb',
                labelField: 'awb',
                searchField: 'awb',
                create: false,
                maxItems: 1,
                placeholder: 'Incepeti sa tastati AWB-ul...',
                render: {
                    no_results: function(data, escape) {
                        return '<div class="no-results text-danger px-2 py-1">Nu am gasit niciun pachet cu acest AWB.</div>';
                    }
                },
                load: function(query, callback) {
                    if (!query.length) return callback();

                    fetch(`?handler=CautareAwb&q=${encodeURIComponent(query)}`)
                        .then(response => response.json())
                        .then(json => {
                            callback(json);
                        }).catch(() => {
                            callback();
                        });
                }
            });
        });
    </script>
}