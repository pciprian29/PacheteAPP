@page
@model PacheteAPP.Pages.UsersPages.CreateUsersModel
@{
    
}

<div class="container mt-4">
    <h2>Adauga un cont nou</h2>

    <form method="post" class="mt-3">
        <div asp-validation-summary="All" class="text-danger"></div>

        <div class="mb-3">
            <label asp-for="Input.email" class="form-label">Email / Username</label>
            <input asp-for="Input.email" class="form-control" />
            <span asp-validation-for="Input.email" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Input.password" class="form-label">Parola</label>
            <input asp-for="Input.password" class="form-control" type="password" />
            <span asp-validation-for="Input.password" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary">Confirma creearea contului</button>
    </form>
</div>