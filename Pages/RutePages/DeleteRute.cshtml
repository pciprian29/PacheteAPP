@page
@model PacheteAPP.Pages.RutePages.DeleteRuteModel
@{
    ViewData["Title"] = "Sterge Ruta";
}

<div class="container mt-4">
    <h2 class="text-danger">Sterge Ruta</h2>
    <h4>Esti sigur ca vrei sa stergi aceasta inregistrare?</h4>
    <hr />
    
    <div class="card shadow-sm border-danger col-md-8">
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-4">Cod Ruta</dt>
                <dd class="col-sm-8"><strong>@Model.Ruta.cod_ruta</strong></dd>

                <dt class="col-sm-4">Tip Ruta</dt>
                <dd class="col-sm-8"><span class="badge bg-secondary">@Model.Ruta.TipRuta?.denumire</span></dd>

                <dt class="col-sm-4">Locatie Plecare</dt>
                <dd class="col-sm-8">@Model.Ruta.locatie_plecare</dd>

                <dt class="col-sm-4">Locatie Destinatie</dt>
                <dd class="col-sm-8">@Model.Ruta.locatie_destinatie</dd>
            </dl>
        </div>
    </div>
    
    <div class="mt-4">
        <form method="post">
            <input type="hidden" asp-for="Ruta.id_ruta" />
            <input type="submit" value="Confirm Stergerea" class="btn btn-danger" />
            <a asp-page="./IndexRute" class="btn btn-secondary ms-2">Anuleaza</a>
        </form>
    </div>
</div>