@page
@model PacheteAPP.Pages.RutePages.DetailsRuteModel
@{
    ViewData["Title"] = "Detalii Ruta";
}

<div class="container mt-4">
    <h2>Detalii Ruta</h2>
    <hr />
    <div class="card shadow-sm col-md-8">
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-4">Cod Ruta</dt>
                <dd class="col-sm-8"><strong>@Model.Ruta.cod_ruta</strong></dd>

                <dt class="col-sm-4">Tip Ruta</dt>
                <dd class="col-sm-8"><span class="badge bg-secondary">@Model.Ruta.TipRuta?.denumire</span></dd>

                <dt class="col-sm-4">Locatie Plecare</dt>
                <dd class="col-sm-8">@Model.Ruta.locatie_plecare</dd>

                <dt class="col-sm-4">Locatie Destinatie</dt>
                <dd class="col-sm-8">@Model.Ruta.locatie_destinatie</dd>
            </dl>
        </div>
    </div>
    <div class="mt-3">
        <a asp-page="./Edit" asp-route-id="@Model.Ruta.id_ruta" class="btn btn-primary">Editeaza</a>
        <a asp-page="./IndexRute" class="btn btn-secondary ms-2">Inapoi la lista</a>
    </div>
</div>
