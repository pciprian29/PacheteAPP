@page
@model PacheteAPP.Pages.IstoricPages.IndexIstoricModificariModel

@{
    ViewData["Title"] = "Istoric Modificari";
}

<h1>Lista Istoric Modificari</h1>

<form method="get" class="mb-4">
    <div class="row g-3">
        <div class="col-md-4">
            <input type="text" name="awb" value="@Model.awbCurent" class="form-control" placeholder="Cauta dupa AWB Pachet" />
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-primary w-100">Aplica Filtre</button>
        </div>
        <div class="col-md-2">
            <a href="?" class="btn btn-outline-secondary w-100">Reset</a>
        </div>
    </div>
    <input type="hidden" name="sort" value="@Model.sortCurent" />
</form>

<table class="table table-striped table-hover align-middle">
    <thead class="table-info">
        <tr>
            <th>
                <a href="?p=1&sort=@(Model.sortCurent == "awb_asc" ? "awb_des" : "awb_asc")&awb=@Model.awbCurent" class="text-decoration-none text-dark">
                    AWB Pachet @(Model.sortCurent == "awb_asc" ? "↑" : Model.sortCurent == "awb_des" ? "↓" : "")
                </a>
            </th>
            <th>Valoare Veche</th>
            <th>Valoare Noua</th>
            <th>Descriere Actiune</th>
            <th>
                <a href="?p=1&sort=@(Model.sortCurent == "data_asc" ? "data_des" : "data_asc")&awb=@Model.awbCurent" class="text-decoration-none text-dark">
                    Data Modificare @(Model.sortCurent == "data_asc" ? "↑" : Model.sortCurent == "data_des" ? "↓" : "")
                </a>
            </th>
            <th>User</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.IstoricModificari)
        {
            <tr>
                <td class="fw-bold">@item.awb_pachet</td>
                <td>@item.valoare_veche</td>
                <td class="fw-bold">@item.valoare_noua</td>
                <td>@item.descriere</td>
                <td>@(item.data_modificare?.ToString("dd/MM/yyyy HH:mm"))</td>
                <td>@item.UserName</td>
                <td>
                    <a asp-page="./DetailsIstoricModificari" asp-route-id_modificare="@item.id_modificare" class="btn btn-sm btn-secondary">Detalii</a>
                </td>
            </tr>
        }
    </tbody>
</table>

<nav aria-label="Page navigation" class="mt-4">
    <ul class="pagination justify-content-center">
        <li class="page-item @(Model.paginaCurenta <= 1 ? "disabled" : "")">
            <a class="page-link" href="?p=1&sort=@Model.sortCurent&awb=@Model.awbCurent"> &laquo;&laquo; </a>
        </li>

        <li class="page-item @(Model.paginaCurenta <= 1 ? "disabled" : "")">
            <a class="page-link" href="?p=@(Model.paginaCurenta - 1)&sort=@Model.sortCurent&awb=@Model.awbCurent"> &lt; </a>
        </li>

        @{
            int maxButoane = 5;
            int startPage = Math.Max(1, Model.paginaCurenta - 2);
            int endPage = Math.Min(Model.paginiTotale, Model.paginaCurenta + 2);

            if (endPage - startPage < maxButoane - 1 && Model.paginiTotale >= maxButoane)
            {
                if (startPage == 1)
                    endPage = maxButoane;
                else if (endPage == Model.paginiTotale)
                    startPage = Model.paginiTotale - maxButoane + 1;
            }
        }

        @if (startPage > 1)
        {
            <li class="page-item disabled"><span class="page-link">...</span></li>
        }

        @for (int i = startPage; i <= endPage; i++)
        {
            <li class="page-item @(i == Model.paginaCurenta ? "active" : "")">
                <a class="page-link" href="?p=@i&sort=@Model.sortCurent&awb=@Model.awbCurent">@i</a>
            </li>
        }

        @if (endPage < Model.paginiTotale)
        {
            <li class="page-item disabled"><span class="page-link">...</span></li>
        }

        <li class="page-item @(Model.paginaCurenta >= Model.paginiTotale ? "disabled" : "")">
            <a class="page-link" href="?p=@(Model.paginaCurenta + 1)&sort=@Model.sortCurent&awb=@Model.awbCurent"> &gt; </a>
        </li>

        <li class="page-item @(Model.paginaCurenta >= Model.paginiTotale ? "disabled" : "")">
            <a class="page-link" href="?p=@Model.paginiTotale&sort=@Model.sortCurent&awb=@Model.awbCurent"> &raquo;&raquo; </a>
        </li>
    </ul>
</nav>