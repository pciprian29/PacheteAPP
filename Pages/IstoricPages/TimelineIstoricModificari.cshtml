@page "{id_pachet:int}"
@model PacheteAPP.Pages.IstoricPages.TimelineIstoricModificariModel

@{
    ViewData["Title"] = "Audit Modificari Pachet";
}

<style>
    .audit-timeline {
        border-left: 3px solid #adb5bd;
        padding-left: 2rem;
        margin-left: 1rem;
        position: relative;
    }

    .audit-item {
        position: relative;
        margin-bottom: 2.5rem;
    }

    .audit-indicator {
        position: absolute;
        left: -2.6rem;
        top: 0;
        width: 18px;
        height: 18px;
        border-radius: 50%;
        background-color: #495057;
        border: 3px solid #fff;
        box-shadow: 0 0 0 1px #adb5bd;
    }
</style>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1">Timeline modificari</h2>
            <h5 class="text-muted">AWB Pachet: <span class="badge bg-dark">@Model.AwbPachet</span></h5>
        </div>
        <a href="javascript:history.back()" class="btn btn-outline-secondary">
            &larr; Inapoi la Detalii
        </a>
    </div>

    <div class="card shadow-sm border-0 bg-light mb-5">
        <div class="card-body">
            <form method="get">
                <div class="row g-3 align-items-end">

                    <div class="col-md-3">
                        <label class="form-label small fw-bold text-muted">Tip Obiect Modificat</label>
                        <select class="form-select" asp-for="TipObiect">
                            <option value="Toate">Toate Modificarile</option>
                            <option value="Pachete">Pachet Principal</option>
                            <option value="Deteriorari">Deteriorari</option>
                            <option value="InformatiiLipsa">Informatii Lipsa</option>
                        </select>
                    </div>

                    <div class="col-md-2">
                        <label class="form-label small fw-bold text-muted">Utilizator</label>
                        <input type="text" class="form-control" asp-for="SearchUser" placeholder="Nume user...">
                    </div>

                    <div class="col-md-3">
                        <label class="form-label small fw-bold text-muted">Data Modificare (Filtru)</label>
                        <input type="date" class="form-control" asp-for="DataFiltru">
                    </div>

                    <div class="col-md-2">
                        <label class="form-label small fw-bold text-muted">Sortare Data</label>
                        <select class="form-select" asp-for="SortData">
                            <option value="desc">Cele mai noi primele &darr;</option>
                            <option value="asc">Cele mai vechi primele &uarr;</option>
                        </select>
                    </div>

                    <div class="col-md-2">
                        <button type="submit" class="btn btn-primary w-100 mb-1">Aplica Filtre</button>
                        <a asp-page="./TimelineIstoricModificari" asp-route-id_pachet="@Model.id_pachet" class="btn btn-outline-secondary w-100 btn-sm">Reseteaza</a>
                    </div>

                </div>
            </form>
        </div>
    </div>

    @if (!Model.IstoricPachet.Any())
    {
        <div class="alert alert-secondary border-0 shadow-sm">
            <i class="bi bi-info-circle me-2"></i> Nu a fost gasita nicio modificare care sa corespunda criteriilor.
        </div>
    }
    else
    {
        <div class="audit-timeline">
            @foreach (var item in Model.IstoricPachet)
            {
                <div class="audit-item">
                    <div class="audit-indicator"></div>

                    <div class="card shadow-sm border-0 bg-white">
                        <div class="card-header bg-light border-bottom-0 py-3 d-flex justify-content-between align-items-center">
                            <div>
                                <span class="badge bg-secondary me-2">ID Modificare: #@item.id_modificare</span>
                                <strong>@item.UserName</strong>
                                <span class="text-muted small">a efectuat o modificare</span>
                            </div>
                            <div class="text-muted small fw-bold">
                                @(item.data_modificare?.ToString("dd/MM/yyyy HH:mm:ss"))
                            </div>
                        </div>

                        <div class="card-body pt-2">
                            <div class="mb-3">
                                <span class="text-uppercase text-muted small fw-bold d-block mb-1">Detalii Modificare:</span>
                                <span class="fs-6 fw-bold">@item.descriere</span>
                            </div>

                            <div class="border rounded overflow-hidden">
                                <div class="row g-0">
                                    <div class="col-md-6 border-end">
                                        <div class="bg-light text-muted p-2 border-bottom small fw-bold text-uppercase">
                                            Valoare Anterioara
                                        </div>
                                        <div class="p-3 bg-white" style="background-color: #fffafa !important;">
                                            @if (string.IsNullOrEmpty(item.valoare_veche))
                                            {
                                                <span class="text-muted fst-italic">N/A (Fara date anterioare)</span>
                                            }
                                            else
                                            {
                                                <div class="text-danger">@item.valoare_veche</div>
                                            }
                                        </div>
                                    </div>

                                    <div class="col-md-6">
                                        <div class="bg-light text-muted p-2 border-bottom small fw-bold text-uppercase">
                                            Valoare Curenta (Noua)
                                        </div>
                                        <div class="p-3 bg-white" style="background-color: #f8fff9 !important;">
                                            @if (string.IsNullOrEmpty(item.valoare_noua))
                                            {
                                                <span class="text-muted fst-italic">N/A (Camp golit)</span>
                                            }
                                            else
                                            {
                                                <span class="text-dark fw-bold">@item.valoare_noua</span>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="mt-3 text-end">
                                <a asp-page="./DetailsIstoricModificari" asp-route-id_modificare="@item.id_modificare" class="btn btn-sm btn-outline-primary">
                                    Vezi Detalii
                                </a>
                            </div>

                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>