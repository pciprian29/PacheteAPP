@page "{id_info_lipsa:int}"
@model PacheteAPP.Pages.InfoLipsaPages.DetailsModel
@{
    ViewData["Title"] = "Detalii Informatii Lipsa";
}

@using Microsoft.AspNetCore.Authorization
@inject IAuthorizationService AuthorizationService

<div class="container mt-4">
    <h1 class="h3 mb-4">Detalii Informatii Lipsa</h1>
    
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">Detalii Informatie Lipsa pentru AWB: @Model.InfoLipsa.awb</h5>
        </div>
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-3">AWB:</dt>
                <dd class="col-sm-9">@Model.InfoLipsa.awb</dd>

                <dt class="col-sm-3">Camp Afectat:</dt>
                <dd class="col-sm-9">@Model.InfoLipsa.camp_afectat</dd>

                <dt class="col-sm-3">Tip Lipsa:</dt>
                <dd class="col-sm-9">@Model.InfoLipsa.tip_lipsa</dd>

                <dt class="col-sm-3">Descriere Lipsa</dt>
                <dd class="col-sm-9">@Model.InfoLipsa.descriere_lipsa</dd>

                <dt class="col-sm-3">Data Inregistrare:</dt>
                <dd class="col-sm-9">@Model.InfoLipsa.data_inregistrare</dd>

                <dt class="col-sm-3">Utilizator Inregistrare:</dt>
                <dd class="col-sm-9">@Model.InfoLipsa.utilizator_inregistrare</dd>
            </dl>

        </div>
        <div class="card-footer text-end">
            @if((await AuthorizationService.AuthorizeAsync(User, "CanView")).Succeeded)
            {
                <a asp-page="/IstoricPages/TimelineIstoricModificari" asp-route-id_pachet="@Model.idPachet" asp-route-TipObiect="InfoLipsa" class="btn btn-outline-info">
                    Vezi Istoric InfoLipsa
                </a>
            }
            @if((await AuthorizationService.AuthorizeAsync(User, "CanEdit")).Succeeded)
            {
                <a asp-page="./EditInfoLipsa" asp-route-id_info_lipsa="@Model.InfoLipsa.id_info_lipsa" class="btn btn-primary">Editeaza</a>
            }
            <a asp-page="./IndexInfoLipsa" class="btn btn-secondary">Inapoi la Lista</a>
        </div>

    </div>

    <div class="card shadow-sm">
        <div class="card-header">
            <h5 class="mb-0">Imagini (@Model.Imagini.Count)</h5>
        </div>
        <div class="card-body">
            @if (Model.Imagini.Any())
            {
                <div class="d-flex flex-wrap gap-2">
                    @foreach (var img in Model.Imagini)
                    {
                        <a href="#" data-bs-toggle="modal" data-bs-target="#modalImagine"
                           data-img-src="/api/imagini/@img.id_imagine">
                            <img src="/api/imagini/@img.id_imagine/thumbnail" width="120" height="120"
                                 style="object-fit: cover;" class="rounded border" alt="Imagine InfoLipsa" />
                        </a>
                    }
                </div>
            }
            else
            {
                <p class="text-muted mb-0">Nicio imagine atasata.</p>
            }
        </div>
    </div>
</div>
    
<div class="modal fade" id="modalImagine" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body text-center">
                <img id="imagineModalMare" src="" class="img-fluid" alt="Imagine marita" />
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('modalImagine').addEventListener('show.bs.modal', function(event) {
            var link = event.relatedTarget;
            var src = link.getAttribute('data-img-src');
            document.getElementById('imagineModalMare').setAttribute('src', src);
        });
    </script>
}